{
  "mcpServers": {
    "netexec": {
      "command": "uv",
      "args": ["run", "--no-sync", "--directory", "/path/to/NetExec-mcp", "netexec-mcp"],
      "env": {
        "NXC_SCOPE": "10.0.0.0/24",
        "NXC_MODE": "recon",
        "NXC_COMMAND": "uv run --no-sync --directory /path/to/NetExec netexec",
        "NXC_PATH": "/home/you/.netexec-mcp/acme",
        "NXC_AUDIT_LOG": "/home/you/.netexec-mcp/acme/audit.jsonl",
        "NXC_PROTOCOLS": "smb,ldap,winrm,mssql,rdp,wmi",
        "NXC_TOOL_MODE": "dynamic"
      }
    }
  }
}
