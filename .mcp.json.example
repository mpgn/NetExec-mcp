{
  "mcpServers": {
    "netexec": {
      "command": "netexec-mcp",
      "args": [],
      "env": {
        "NXC_COMMAND": "netexec",
        "NXC_PROTOCOLS": "smb,ldap,rdp,winrm,rdp,wmi,mssql",
        "NXC_SCOPE": "10.0.0.0/24,192.168.56.0/24",
        "NXC_MODE": "recon",
        "NXC_TIMEOUT": "300",
        "NXC_MAX_TARGETS": "256",
        "NXC_AUDIT_LOG": "/home/bonclay/.netexec-mcp/audit.jsonl",
        "NXC_WORKSPACE": "default",
        "NXC_TOOL_MODE": "dynamic",
        "NXC_PATH": "~/.nxc"
      }
    }
  }
}
